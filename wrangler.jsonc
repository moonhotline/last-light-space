{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-light-party",
  "main": "frontend/space-escape/party/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ],
  "routes": [
    {
      "pattern": "party.oodai.space",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Main"]
    }
  ]
}
